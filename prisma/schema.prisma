generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IntegracaoBling {
  id          Int    @id
  credenciais String
}

model EnvioVenda {
  id           String    @id @db.Uuid
  usuarioId    String
  verificacao  String
  etapa        String    @default("PENDENTE")
  blingId      BigInt?
  blingNumero  BigInt?
  trelloUrl    String?
  carga        String?
  criadoEm     DateTime  @default(now())
  bloqueadoAte DateTime?

  @@index([usuarioId, criadoEm])
}

model Colaborador {
  id      Int    @id @default(autoincrement())
  nome    String
  cargo   String
  cpf     String @unique // CPF único para não repetir funcionários
  salario Float @default(0)
  inativadoEm DateTime?

  pontos Ponto[] // Um colaborador tem muitos pontos

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])
  mensagensInternasEnviadas MensagemInterna[] @relation("RemetenteInterno")
  mensagensInternasRecebidas MensagemInterna[] @relation("DestinatarioInterno")
}

model MensagemInterna {
  id Int @id @default(autoincrement())
  remetenteId Int?
  destinatarioId Int?
  remetenteAvulsoId String?
  destinatarioAvulsoId String?
  remetenteChave String @default(dbgenerated())
  destinatarioChave String @default(dbgenerated())
  pedidoId String @db.Uuid
  texto String @db.VarChar(4000)
  criadaEm DateTime @default(now())
  lidaEm DateTime?
  citacaoId Int?
  anexoNome String?
  anexoMime String?
  anexoDados Bytes?
  apagadaEm DateTime?
  encaminhada Boolean @default(false)
  citacao MensagemInterna? @relation("CitacaoInterna", fields: [citacaoId], references: [id], onDelete: SetNull)
  respostas MensagemInterna[] @relation("CitacaoInterna")
  remetente Colaborador? @relation("RemetenteInterno", fields: [remetenteId], references: [id], onDelete: Cascade)
  destinatario Colaborador? @relation("DestinatarioInterno", fields: [destinatarioId], references: [id], onDelete: Cascade)

  @@index([remetenteId, destinatarioId, id])
  @@index([destinatarioId, lidaEm, remetenteId, id])
  @@unique([remetenteId, pedidoId])
  @@index([remetenteChave, destinatarioChave, id])
  @@index([destinatarioChave, lidaEm, remetenteChave, id])
  @@unique([remetenteChave, pedidoId])
  @@index([citacaoId])
}

model Ponto {
  id       Int      @id @default(autoincrement())
  cpf      String
  tipo     String
  dataHora DateTime @default(now())

  // Criando a relação:
  colaborador Colaborador @relation(fields: [cpf], references: [cpf], onDelete: Cascade)
}

model User {
  clientesFixados String[] @default([])
  id        String   @id @default(uuid())
  email     String   @unique
  apelido   String?  @db.VarChar(40)
  password  String // Aqui vai o hash da senha criptografada
  role      String   @default("USER") // Ex: "ADMIN", "SUPERVISOR", "USER"
  createdAt DateTime @default(now())

  colaborador Colaborador?
  sessoes Sessao[]
  clientes Cliente[]
  atribuicoes AtribuicaoCliente[]
  mensagens MensagemWhatsApp[]
  leituras LeituraConversa[]
}

model Sessao {
  tokenHash String @id
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Material {
  id        String  @id @default(uuid())
  nome      String?
  espessura String?
  cor       String?
  descricao String?

  custo     Float
  valorVendaInteiro Float?
  ValorVendaFracionado Float?

  estoque   Float
  estoquePadrao Int @default(0)

  largura    Float? // mm
  altura     Float? // mm
  velocidadeCorte Float? // minutos

  categoriaId String
  categoria   MaterialCatogoria @relation(fields: [categoriaId], references: [id])
  foto FotoItem?
}

model MaterialCatogoria {
  id   String @id @default(uuid())
  nome String

  materiais Material[]
}

model Produto {
  id          String   @id @default(uuid())
  nome        String
  descricao   String?
  estoque     Int      @default(0)
  estoquePadrao Int    @default(0)
  precoCusto  Float
  precoVenda  Float
  createdAt   DateTime @default(now())
  foto FotoItem?
}

model FotoItem {
  id String @id @default(uuid())
  dados Bytes
  mimeType String @default("image/jpeg")
  updatedAt DateTime @updatedAt
  materialId String? @unique
  produtoId String? @unique
  material Material? @relation(fields: [materialId], references: [id], onDelete: Cascade)
  produto Produto? @relation(fields: [produtoId], references: [id], onDelete: Cascade)
}

model Cliente {
  id String @id @default(uuid())
  nome String @db.VarChar(120)
  telefone String? @unique @db.VarChar(16)
  responsavelId String?
  responsavel User? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  etiquetas ClienteEtiqueta[]
  atribuicoes AtribuicaoCliente[]
  mensagens MensagemWhatsApp[]
  identidades IdentidadeWhatsApp[]
  foto FotoContato?
  ultimaMensagemEm DateTime?
  conversaExcluidaEm DateTime?
  versaoEntradaExcluida BigInt @default(0)
  versaoEntrada BigInt @default(0)
  versaoMensagens BigInt @default(0)
  leituras LeituraConversa[]

  @@index([responsavelId, nome, id])
  @@index([responsavelId, ultimaMensagemEm])
}

model FotoContato {
  clienteId String @id
  url String?
  consultadaEm DateTime?
  pendente Boolean @default(true)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model LeituraConversa {
  userId String
  clienteId String
  versao BigInt @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  @@id([userId, clienteId])
  @@index([clienteId])
}

model EstadoServicoWhatsApp {
  id           String   @id
  status       String
  numero       String?
  atualizadoEm DateTime @default(now())
  qr String?
  qrExpiraEm DateTime?
  mensagem String?
  comando String?
  comandoEm DateTime?
}

model IdentidadeWhatsApp {
  conta String
  jid String
  clienteId String
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  @@id([conta, jid])
  @@index([clienteId])
}

model MensagemWhatsApp {
  arquivo ArquivoWhatsApp?
  id String @id @default(uuid())
  clienteId String
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  conta String
  externaId String?
  pedidoId String? @unique
  conteudoHash String?
  citacao Json?
  autorId String?
  autor User? @relation(fields: [autorId], references: [id], onDelete: SetNull)
  direcao String
  tipo String @default("chat")
  texto String @default("")
  status String
  ack Int @default(0)
  erro String?
  enviadoEm DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  midia MidiaWhatsApp?
  @@unique([conta, externaId])
  @@index([clienteId, enviadoEm, id])
  @@index([conta, enviadoEm])
  @@index([status, createdAt])
}

model MidiaWhatsApp {
  mensagemId String @id
  mensagem MensagemWhatsApp @relation(fields: [mensagemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dados Bytes
  previa Bytes?
  preparadaEm DateTime?
  mimeType String
  nome String
  tamanho Int?
}

model TextoRapido {
  id String @id @default(uuid())
  label String @db.VarChar(80)
  texto String
  ordem Int @default(autoincrement())
}

model Etiqueta {
  id String @id @default(uuid())
  nome String @unique @db.VarChar(40)
  clientes ClienteEtiqueta[]
}

model ClienteEtiqueta {
  clienteId String
  etiquetaId String
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  etiqueta Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([clienteId, etiquetaId])
  @@index([etiquetaId])
}

model AtribuicaoCliente {
  id String @id @default(uuid())
  clienteId String
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  atorId String?
  ator User? @relation(fields: [atorId], references: [id], onDelete: SetNull)
  anteriorId String?
  novoId String?
  createdAt DateTime @default(now())

  @@index([clienteId, createdAt])
}

model TransferenciaWhatsApp {
  tokenHash String @id
  payload Json
  expiresAt DateTime
  @@index([expiresAt])
}
model PonteMidiaWhatsApp {
  id String @id
  url String
  atualizadoEm DateTime
}
model ArquivoWhatsApp {
  mensagemId String @id
  chave String @unique
  tamanho Int
  mensagem MensagemWhatsApp @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
}
